{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.auxDir": "%OUTDIR%",
  "latex-workshop.latex.recipes": [
    {
      "name": "pdfLaTeX → BibTeX → pdfLaTeX ×2 (MacTeX / MiKTeX)",
      "tools": [
        "pdflatex-build",
        "bibtex-build",
        "pdflatex-build",
        "pdflatex-build"
      ]
    },
    {
      "name": "pdfLaTeX (una pasada)",
      "tools": [
        "pdflatex-build"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex-build",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-output-directory=build",
        "%DOCFILE%.tex"
      ]
    },
    {
      "name": "bibtex-build",
      "command": "bibtex",
      "args": [
        "build/%DOCFILE%"
      ]
    }
  ],
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.synctex.gz",
    "*.nav",
    "*.vrb"
  ]
}
